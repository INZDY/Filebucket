# PostgreSQL connection string.
# If using Supabase and your local network only supports IPv4, use the Supavisor connection
# pooler URL on port 5432 (Session Mode) rather than the direct connection (which defaults to IPv6-only).
# Format: postgresql://postgres.[project-ref]:[password]@aws-[region].pooler.supabase.com:5432/[database]
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/filebucket?schema=public"

# Auth.js
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Seeded admin account
FILEBUCKET_ADMIN_EMAIL="admin@filebucket.local"
FILEBUCKET_ADMIN_PASSWORD="replace-with-a-strong-password"

# Cloudflare R2 blob storage (required for media). Other S3 providers are not supported yet.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Optional: public CDN base URL for media, if the bucket has a public domain
# R2_PUBLIC_BASE_URL=""

# Optional: OAuth providers
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""